# These are placeholders and local addresses, never real credentials.
# Browser-visible values are embedded during build. Rebuild after changing them.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-own-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-own-service-role-key
# Optional server-to-server URL when the app runs inside Docker.
# Must reach the SAME database as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_INTERNAL_URL=
# Sign-up closes after the first account, who owns this Billr. Set to true to
# let more people sign up (for example to add a teammate), then remove it.
BILLR_OPEN_SIGNUP=
# Optional card payments, on your own Stripe account. Set all three or none.
# The webhook endpoint is <NEXT_PUBLIC_APP_URL>/api/stripe/webhook.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional invoice email: use your own Resend key and verified sender domain.
RESEND_API_KEY=
RESEND_INVOICE_FROM=
# Optional outbound email cap, sends per business per 24 hours. Uncapped unless set.
BILLR_EMAIL_DAILY_LIMIT=
# Optional. Name the single-value header YOUR reverse proxy OVERWRITES with the
# real client address (commonly X-Real-IP). Leave empty when the proxy appends
# to X-Forwarded-For instead; Billr reads that list's last entry. Never name a
# header the proxy passes through: rate limits key on this value.
BILLR_TRUSTED_IP_HEADER=
